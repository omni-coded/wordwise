{
  "name": "wordwise",
  "private": true,
  "version": "1.0.0",
  "description": "WordWise \u2014 Find Words. Expand Your World. A word-search game for adults with built-in learning.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "content:report": "tsx scripts/content-report.ts",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "e2e": "node e2e/smoke.cjs",
    "build:artifact": "node scripts/build.mjs --artifact"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
